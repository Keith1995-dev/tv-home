<?xml version="1.0" encoding="utf-8"?>
<!-- Template for res/values/secrets.xml: your keys and anything that identifies you or your home.
     The build copies this there if it's missing; fill it in and rebuild. secrets.xml is not committed to git. -->
<resources>
    <!-- Claude API key (console.anthropic.com) for Discover, Ask and the fact line. Empty = those are off. -->
    <string name="claude_api_key" translatable="false"></string>
    <!-- Personal view feed: the Apps Script web app URL with ?token=... (tools/personal/README.md). Empty = off. -->
    <string name="personal_feed_url" translatable="false"></string>
    <!-- Stremio "continue watching": your auth key from web.stremio.com (tools/personal/README.md). Empty = off. -->
    <string name="stremio_auth_key" translatable="false"></string>

    <!-- Weather card (Open-Meteo, free, no key). -->
    <string name="home_city" translatable="false">London</string>
    <string name="home_lat" translatable="false">51.5072</string>
    <string name="home_lon" translatable="false">-0.1276</string>

    <!-- The Update button downloads the APK from the first of these that answers (tools/update-server.sh),
         e.g. http://192.168.1.20:8000/tvhome.apk with your computer's IP. Empty list = off. -->
    <string-array name="update_urls">
    </string-array>

    <!-- Phone remote server (tools/remote.sh), e.g. http://192.168.1.20:8080. Empty list = off. -->
    <string-array name="remote_urls">
    </string-array>
</resources>
